# Application environment: development or production
APP_ENV=development

# Use unique, randomly generated values for production.
SECRET_KEY=replace_with_a_random_secret
JWT_SECRET_KEY=replace_with_a_different_random_secret

# Local MongoDB or MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/ai_study_assistant

# Optional AI configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=allam-2-7b

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:5000/api/auth/oauth/github/callback

# Server settings used by python backend/app.py
HOST=127.0.0.1
PORT=5000
